{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-server",
      "type": "shell",
      "command": "npm run startDebug",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".*",
            "file": 1,
            "location": 2,
            "message": 0
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Started Webpack Dev Server.*|.*compiled successfully.*|.*Waiting for changes.*"
        }
      },
      "presentation": {
        "reveal": "always"
      }
    }
  ]
}
